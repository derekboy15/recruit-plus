<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<gameSystem id="sys-i" name="Info System" revision="1" xmlns="http://www.battlescribe.net/schema/gameSystemSchema">
  <profileTypes>
    <profileType id="pt-unit" name="Unit"/>
    <profileType id="pt-weapon" name="Weapon"/>
    <profileType id="pt-abilities" name="Abilities"/>
  </profileTypes>
  <sharedRules>
    <rule id="rule-sys" name="Combi Weapon" hidden="false">
      <description>When the bearer shoots with this weapon, choose one or both of the profiles below.</description>
    </rule>
  </sharedRules>
</gameSystem>
