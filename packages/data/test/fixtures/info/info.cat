<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue id="cat-info" name="Info Faction" library="false" gameSystemId="sys-i" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <catalogueLinks>
    <catalogueLink id="cl-i" name="Info Library" targetId="cat-ilib" type="catalogue" importRootEntries="false"/>
  </catalogueLinks>
  <entryLinks>
    <entryLink id="el-unit" name="Lords" hidden="false" targetId="se-unit" type="selectionEntry">
      <infoLinks>
        <infoLink id="il-el-unit" name="Combi Weapon" hidden="false" targetId="rule-sys" type="rule"/>
      </infoLinks>
    </entryLink>
  </entryLinks>
  <sharedSelectionEntries>
    <selectionEntry id="se-unit" name="Lords" hidden="false" type="unit">
      <profiles>
        <profile id="p-lord" name="Lord" hidden="false" typeId="pt-unit" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="c-m">5&quot;</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="il-unit" name="Combi Weapon" hidden="false" targetId="rule-sys" type="rule"/>
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="se-model" name="Lord" hidden="false" type="model">
          <rules>
            <rule id="r-model" name="Model Rule" hidden="false">
              <description>Only for the model.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry id="se-gun" name="Gauss Blaster" hidden="false" type="upgrade">
              <profiles>
                <profile id="p-gun" name="Gauss blaster" hidden="false" typeId="pt-weapon" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="c-r">24&quot;</characteristic>
                    <characteristic name="S" typeId="c-s">5</characteristic>
                    <characteristic name="Abilities" typeId="c-ab"></characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="se-nothing" name="Nothing" hidden="false" type="upgrade"/>
          </selectionEntries>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="sg-traits" name="Warlord Traits" hidden="false">
          <rules>
            <rule id="r-group" name="Traits" hidden="false">
              <description>Pick one.</description>
            </rule>
          </rules>
          <entryLinks>
            <entryLink id="el-relic" name="Relic: The Shield" hidden="false" targetId="se-lib-relic" type="selectionEntry"/>
            <entryLink id="el-own" name="Gauss Blaster" hidden="false" targetId="se-gun" type="selectionEntry">
              <infoLinks>
                <infoLink id="il-own" name="Combi Weapon" hidden="false" targetId="rule-sys" type="rule"/>
              </infoLinks>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry id="se-trait" name="Warlord Trait (Novokh): Blood-Fuelled Fury" hidden="true" type="upgrade">
      <infoLinks>
        <infoLink id="il-trait" name="Blood-Fuelled Fury" hidden="true" targetId="rule-lib" type="rule"/>
        <infoLink id="il-trait-2" name="Indomitable" hidden="false" targetId="p-lib-ability" type="profile"/>
        <infoLink id="il-empty" name="Empty" hidden="false" targetId="rule-empty" type="rule"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry id="se-dyn" name="Dynasty: Novokh" hidden="false" type="upgrade">
      <infoLinks>
        <infoLink id="il-dyn" name="Novokh" hidden="false" targetId="ig-dyn" type="infoGroup"/>
      </infoLinks>
    </selectionEntry>
    <!-- Plan F2: options with no text of their own take the text their selection reveals. -->
    <selectionEntry id="se-knight" name="Knight" hidden="false" type="unit">
      <rules>
        <rule id="r-marker" name="Marker rule" hidden="false">
          <modifiers><modifier type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="or"><conditions><condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="se-marker" type="equalTo"/><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="se-other" type="atLeast"/></conditions></conditionGroup></conditionGroups></modifier></modifiers>
          <description>The bearer re-rolls hit rolls of 1.</description>
        </rule>
        <rule id="r-other" name="Other rule" hidden="false">
          <modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="se-other" type="equalTo"/></conditions></modifier></modifiers>
          <description>Only with the other option.</description>
        </rule>
        <rule id="r-own-reveal" name="Own reveal" hidden="false">
          <modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="se-own" type="equalTo"/></conditions></modifier></modifiers>
          <description>Revealed by an option that has text of its own.</description>
        </rule>
        <rule id="r-lib-reveal" name="Library marker rule" hidden="false">
          <modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="se-lib-marker" type="equalTo"/></conditions></modifier></modifiers>
          <description>Revealed in the faction by a library marker.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry id="se-base" name="Laser destructor" hidden="false" type="upgrade">
          <profiles>
            <profile id="p-base" name="Base gun" hidden="false" typeId="pt-weapon" typeName="Weapon">
              <modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="se-marker" type="equalTo"/></conditions></modifier></modifiers>
              <characteristics>
                <characteristic name="Range" typeId="c-r">72&quot;</characteristic>
                <characteristic name="S" typeId="c-s">14</characteristic>
              </characteristics>
            </profile>
            <profile id="p-marker-gun" name="Marker gun" hidden="false" typeId="pt-weapon" typeName="Weapon">
              <modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="se-marker" type="equalTo"/></conditions></modifier></modifiers>
              <characteristics>
                <characteristic name="Range" typeId="c-r">72&quot;</characteristic>
                <characteristic name="S" typeId="c-s">16</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <entryLinks>
        <entryLink id="el-lib-marker" name="Relic: The Library Marker" hidden="false" targetId="se-lib-marker" type="selectionEntry"/>
      </entryLinks>
    </selectionEntry>
    <selectionEntry id="se-marker" name="Relic: The Marker" hidden="false" type="upgrade"/>
    <selectionEntry id="se-other" name="Other option" hidden="false" type="upgrade"/>
    <selectionEntry id="se-own" name="Army of Renown: Own" hidden="false" type="upgrade">
      <rules>
        <rule id="r-own" name="Own rule" hidden="false">
          <description>This option has a rule of its own.</description>
        </rule>
      </rules>
    </selectionEntry>
  </sharedSelectionEntries>
  <sharedSelectionEntryGroups>
    <selectionEntryGroup id="sg-honours" name="Battle Honours" hidden="false">
      <selectionEntries>
        <selectionEntry id="se-honour" name="1. Dark Champion" hidden="false" type="upgrade">
          <rules>
            <rule id="r-honour" name="Dark Champion" hidden="false">
              <description>A Crusade upgrade.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="sg-shared" name="Dynasties" hidden="false">
      <entryLinks>
        <entryLink id="el-dyn" name="Dynasty: Novokh" hidden="false" targetId="se-dyn" type="selectionEntry"/>
      </entryLinks>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
