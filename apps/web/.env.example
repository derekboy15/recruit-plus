# Copy to .env.local for local development. Production values are set in Vercel (see DEPLOY.md, step 6).

# Supabase project (Project Settings > API). Leave empty locally to use the "Continue (dev)" sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The privacy page's contact for account and data deletion requests. Required for a production deploy.
VITE_CONTACT_EMAIL=

# Set to "dev" to force the local developer sign-in. Ignored by production builds, and refused for a production deploy.
VITE_AUTH_MODE=
